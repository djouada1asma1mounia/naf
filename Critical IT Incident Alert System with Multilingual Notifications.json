        "operation": "executeQuery",
        "query": "SELECT i.id, i.type, i.description, i.date_debut, i.etat, \n       m.numeroInventaire, m.marque\nFROM intervention i\nJOIN material m ON i.material_id = m.numeroSerie\nWHERE i.date_debut >= NOW() - INTERVAL 24 HOUR\nORDER BY i.date_debut DESC",
        "options": {
          "queryReplacement": ""
        }
      },
