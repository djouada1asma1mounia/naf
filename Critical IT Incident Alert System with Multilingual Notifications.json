    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.numeroSerie, m.numeroInventaire, m.marque, \n       m.etat, c.designation as categorie,\n       s.designation as structure\nFROM material m\nJOIN categorie c ON m.categorie_id = c.id\nJOIN structure s ON m.structure_id = s.id\nWHERE m.etat = 'En panne'\nORDER BY m.numeroSerie DESC",
        "options": {}
      },
