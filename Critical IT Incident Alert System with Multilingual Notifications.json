    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT i.id, i.type, i.description, i.date_debut, i.etat,\n       m.numeroInventaire, m.marque\nFROM intervention i\nJOIN material m ON i.material_id = m.numeroSerie\nWHERE i.etat = 'En cours' \nAND i.date_debut <= NOW() - INTERVAL 48 HOUR\nORDER BY i.date_debut ASC",
        "options": {
          "queryReplacement": ""
        }
      },
