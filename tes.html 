​let currentChaletId = 1;
​// Render Chalet Diagram & Table
function renderChalet(chaletId) {
currentChaletId = chaletId;
const data = chaletsData[chaletId];
​document.getElementById('chaletTitle').innerText = مخطط وجرد عتاد: ${data.title};
document.getElementById('chaletSubtitle').innerText = القسم: ${data.department} | التاريخ: 03-11-2026;
document.getElementById('chaletRef').innerText = data.ref;
​// Render Floorplan Offices
const officesGrid = document.getElementById('officesGrid');
officesGrid.innerHTML = '';
​const tableBody = document.getElementById('devicesTableBody');
tableBody.innerHTML = '';
​data.offices.forEach((office, index) => {
// Office Box
const officeCard = document.createElement('div');
officeCard.className = 'office-card';
​const badgesHtml = office.devices.map(d => <span class="dev-badge ${d.cat}">${d.id}: ${d.type.split(' ')[0]}</span>).join('');
​const isShared = office.userName.includes("مشترك");
​officeCard.innerHTML = <div> <div class="office-card-header"> <span class="office-name-tag">${office.roomName}</span> <span class="office-user-tag">${office.userName}</span> </div> <div style="font-size: 0.75rem; color: #64748b; margin-bottom: 4px;">${office.userRole}</div> <div class="devices-tags-container"> ${badgesHtml} </div> </div> <div class="office-actions"> ${!isShared ?<button class="btn-print-person" onclick="openEmployeeSheet(${chaletId},${index})">🖨️ طباعة بطاقة الموظف</button>:<span style="font-size: 0.75rem; color:#94a3b8;">تجهيز بنية تحتية</span>} </div> ;
officesGrid.appendChild(officeCard);
​// Populate Table
office.devices.forEach(dev => {
const row = document.createElement('tr');
row.innerHTML = <td class="mono-cell" style="text-align: center;">${dev.id}</td> <td>${office.roomName}</td> <td><strong>${office.userName}</strong></td> <td>${dev.type}</td> <td>${dev.model}</td> <td class="mono-cell">${dev.sn}</td> <td class="mono-cell" style="text-align: center;">${dev.tag}</td>;
tableBody.appendChild(row);
});
});
}
​// Switch Tab
function switchChalet(chaletId) {
document.querySelectorAll('.tab-btn').forEach((btn, idx) => {
btn.classList.toggle('active', idx + 1 === chaletId);
});
closeEmployeeSheet();
renderChalet(chaletId);
}
